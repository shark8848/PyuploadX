server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 使用 Docker 内置 DNS，在请求时解析 upstream，避免启动时 DNS 抖动导致 nginx 退出。
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upload_api http://upload-api:8000;

    # Portal 鉴权：默认注入启动时下发的 token（PORTAL_API_TOKEN）；
    # 浏览器显式携带 X-API-Key 时（手动登录）优先使用客户端提供的 key。
    set $portal_key "$PORTAL_API_TOKEN";
    if ($http_x_api_key) {
        set $portal_key $http_x_api_key;
    }

    # index.html 不缓存：保证刷新即拿到最新入口，避免引用旧 hashed 资源。
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /v1/ {
        proxy_pass $upload_api;
        proxy_set_header X-API-Key $portal_key;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_read_timeout 300s;
        client_max_body_size 0;
    }

    location /healthz {
        proxy_pass $upload_api;
        proxy_set_header X-API-Key $portal_key;
    }
}
